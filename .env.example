# ==========================================
# Frontend Environment Variables (Next.js)
# ==========================================

# URL of your Next.js frontend (Use your Vercel deployment URL in production)
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt NextAuth JWT tokens 
# (Generate a random string, e.g., using `openssl rand -base64 32`)
NEXTAUTH_SECRET=your_super_secret_random_string_here

# Google OAuth Credentials (Get these from Google Cloud Developer Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Backend Environment Variables (FastAPI)
# ==========================================

# Database Connection URL (SQLite is used for local development)
# For Vercel production, use a PostgreSQL URL (e.g., from Supabase, Neon, or Vercel Postgres)
DATABASE_URL=sqlite:///./embroidery.db

# Secret used to sign backend JWT tokens
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Secret Key for processing payments (Get from Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
